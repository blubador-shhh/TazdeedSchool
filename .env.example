# ---------------------------------------------------------------------------
# Tazdeed School — environment template
# Copy to `.env.local` and fill in the values from:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app
#
# These are *client* values: they are shipped to the browser by design.
# Security is enforced by firestore.rules, never by hiding these values.
# NEVER put a service account / private key here — the Admin SDK is not used.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Single-school system. Every document carries this identifier.
NEXT_PUBLIC_SCHOOL_ID=tazdeed-school

# Default UI language: bn | en
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# Optional local fallback used when no Firebase project is configured yet.
# Data is then kept in the browser only and the UI is clearly labelled "Demo".
# Set to "false" to force a hard failure instead of the local fallback.
NEXT_PUBLIC_ENABLE_LOCAL_FALLBACK=true

# Build a static bundle for Firebase Hosting (`out/`).
NEXT_STATIC_EXPORT=1
